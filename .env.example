# Variables de entorno para habilitar cuentas y sincronizacion en Supabase
# Si se dejan vacias, StudyFlow funciona en modo local offline con IndexedDB.
VITE_SUPABASE_URL=
# Usa la clave "Publishable key" (sb_publishable_...) o "anon public" de Supabase:
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

